# Copy to .env and adjust the values for your environment.

# App
NODE_ENV=development
PORT=5000
# Origin allowed by CORS (the frontend URL)
FRONTEND_URL=http://localhost:3000
# Public base URL of this API — used to build URLs for uploaded files.
# Defaults to http://localhost:${PORT} when unset.
API_PUBLIC_URL=http://localhost:5000

# Database — matches docker-compose.yml (postgres on port 5433)
DATABASE_URL="postgresql://postgres:datapostgres@localhost:5433/tcc-music"

# Auth — must be the SAME secret the frontend uses to verify the JWT
JWT_SECRET=use-the-same-value-in-frontend-and-backend

# Transactional e-mail (password recovery)
RESEND_API_KEY=your-resend-api-key
